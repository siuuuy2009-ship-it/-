# Vercel: use the Supabase Connect > Transaction pooler URI (port 6543).
# Keep the real value only in Vercel settings or an ignored .env.local file.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# Optional: the database root certificate if your connection requires its CA.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Vercel: honor packageManager (pnpm 11.19.0) for every install step.
ENABLE_EXPERIMENTAL_COREPACK=1
